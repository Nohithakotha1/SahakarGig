{
  "name": "sahakargig",
  "version": "1.0.0",
  "private": true,
  "description": "SahakarGig - Cooperative-Owned Digital Marketplace Platform",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm --prefix Frontend install --no-audit --no-fund && npm --prefix Backend install --no-audit --no-fund && npm --prefix Frontend run build",
    "build": "npm --prefix Frontend run build",
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "lint": "npm --prefix Frontend run lint",
    "backend:dev": "npm --prefix Backend run dev",
    "insurance:dev": "npm --prefix Insurance run dev",
    "seed": "node Database/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.13.3",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1"
  }
}
